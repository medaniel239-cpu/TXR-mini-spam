-- ========== MOOD DETECTOR ==========
local function detectMood(text)
    if not text then return "NORMAL" end
    
    text = text:lower()
    
    -- ANGRY keywords
    local angryWords = {
        "bsdk", "mc", "bkl", "madarchod", "fuck", "shit", "randi", "kutta",
        "gandu", "chutiye", "harami", "suar", "ullu", "gadha", "bakwas",
        "kyun", "kya", "kyu", "jaa", "nikal", "chup", "mar", "mara",
        "fuck you", "motherfucker", "asshole", "bastard", "dick"
    }
    
    -- HAPPY keywords
    local happyWords = {
        "hello", "hi", "hey", "hola", "namaste", "kaise ho", "kya haal",
        "how are you", "whats up", "sup", "good", "nice", "great", "awesome",
        "cool", "best", "love", "like", "thank", "thanks", "welcome",
        "haan", "yes", "ok", "theek", "achha", "hmm", "yeah", "yup"
    }
    
    -- SAD keywords
    local sadWords = {
        "sorry", "sad", "dukhi", "ro raha", "rone", "gum", "hurt", "pain",
        "tired", "thak", "bored", "bore", "lonely", "alone", "missing",
        "miss", "yaad", "chinta", "worried", "anxious", "depressed"
    }
    
    -- Count matches
    local angryCount = 0
    local happyCount = 0
    local sadCount = 0
    
    for _, word in ipairs(angryWords) do
        if text:find(word, 1, true) then angryCount = angryCount + 1 end
    end
    
    for _, word in ipairs(happyWords) do
        if text:find(word, 1, true) then happyCount = happyCount + 1 end
    end
    
    for _, word in ipairs(sadWords) do
        if text:find(word, 1, true) then sadCount = sadCount + 1 end
    end
    
    -- Determine mood
    if angryCount > happyCount and angryCount > sadCount then
        return "ANGRY"
    elseif happyCount > angryCount and happyCount > sadCount then
        return "HAPPY"
    elseif sadCount > angryCount and sadCount > happyCount then
        return "SAD"
    else
        return "NORMAL"
    end
end

