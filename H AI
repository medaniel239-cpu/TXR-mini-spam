-- ========== TAG FILTER ==========
local function removeTags(text)
    if not text then return text end
    
    local result = text:gsub("@", "＠")
    result = result:gsub("e", "е"):gsub("a", "а"):gsub("o", "о")
    result = result:gsub("y", "у"):gsub("v", "ν"):gsub("r", "г")
    result = result:gsub("n", "п"):gsub("h", "һ"):gsub("l", "ӏ")
    
    return result
end

-- ========== ANTI-BAN ==========
local function getSafeDelay()
    local currentTime = time()
    
    for i = #state.messageTimestamps, 1, -1 do
        if currentTime - state.messageTimestamps[i] > 60 then
            table.remove(state.messageTimestamps, i)
        end
    end
    
    local count = #state.messageTimestamps
    local delay = state.spamSpeed
    
    if count > 20 then delay = delay * 2.5
    elseif count > 15 then delay = delay * 2.0
    elseif count > 10 then delay = delay * 1.5
    elseif count > 5 then delay = delay * 1.2 end
    
    return math.max(1.0, delay)
end

-- ========== MEMORY ==========
local function addToMemory(user, msg, response)
    table.insert(state.memory, 1, {
        user = user,
        message = msg,
        response = response,
        time = time()
    })
    
    if #state.memory > 10 then
        table.remove(state.memory)
    end
end

