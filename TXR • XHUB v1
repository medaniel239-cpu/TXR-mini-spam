-- ========== ANTI-BAN SYSTEM ==========
local function getSafeDelay()
    local currentTime = time()
    
    for i = #messageTimestamps, 1, -1 do
        if currentTime - messageTimestamps[i] > 60 then
            table.remove(messageTimestamps, i)
        end
    end
    
    local messagesLastMinute = #messageTimestamps
    local delay = spamSpeed
    
    if messagesLastMinute > 25 then
        delay = delay * 2.5
    elseif messagesLastMinute > 20 then
        delay = delay * 2.0
    elseif messagesLastMinute > 15 then
        delay = delay * 1.5
    elseif messagesLastMinute > 10 then
        delay = delay * 1.2
    end
    
    delay = delay * (math.random(85, 115) / 100)
    return math.max(0.3, delay)
end

-- ========== X-SPACING FILTER ==========
local function xSpacingFilter(text)
    local words = text:split(" ")
    local result = {}
    
    for _, word in ipairs(words) do
        local newWord = ""
        for i = 1, #word do
            local letter = word:sub(i,i)
            newWord = newWord .. letter
            if i < #word then
                newWord = newWord .. "x"
            end
        end
        table.insert(result, newWord)
    end
    
    return table.concat(result, " ")
end

