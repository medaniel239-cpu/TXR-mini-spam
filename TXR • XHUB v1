-- ========== FUNCTIONS ==========
local function sendMessage(targetName, messageText, isGaliMessage, useLocalStyle)
    local channel = TextChatService.TextChannels.RBXGeneral
    if channel then
        local finalText
        
        if useLocalStyle then
            finalText = getLocalStyleMessage(targetName)
        elseif isGaliMessage then
            finalText = targetName .. " " .. xSpacingFilter(messageText)
        else
            finalText = targetName .. " " .. messageText
        end
        
        channel:SendAsync(finalText)
        
        lastMessageTime = time()
        table.insert(messageTimestamps, lastMessageTime)
        if #messageTimestamps > 30 then
            table.remove(messageTimestamps, 1)
        end
        
        messageCount = messageCount + 1
        counter.Text = messageCount .. " msgs"
        autoSpamOnceCount = autoSpamOnceCount + 1
        local remaining = AUTO_SPAM_INTERVAL - ((autoSpamOnceCount - 1) % AUTO_SPAM_INTERVAL)
        autoLabel.Text = remaining
    end
end

