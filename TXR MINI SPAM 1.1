-- ========== SIMPLE 2-FILTER BYPASS ==========
local function simpleBypass(text)
    -- Sirf 2 simple filters - readable bhi rahe, tags bhi na aaye
    
    -- Filter 1: Small Caps (most readable)
    local smallcaps = {
        ['a']='ᴀ', ['b']='ʙ', ['c']='ᴄ', ['d']='ᴅ', ['e']='ᴇ',
        ['f']='ꜰ', ['g']='ɢ', ['h']='ʜ', ['i']='ɪ', ['j']='ᴊ',
        ['k']='ᴋ', ['l']='ʟ', ['m']='ᴍ', ['n']='ɴ', ['o']='ᴏ',
        ['p']='ᴘ', ['q']='ǫ', ['r']='ʀ', ['s']='s', ['t']='ᴛ',
        ['u']='ᴜ', ['v']='ᴠ', ['w']='ᴡ', ['x']='x', ['y']='ʏ', ['z']='ᴢ',
    }
    
    -- Filter 2: Fullwidth (normal jaisa dikhta hai)
    local fullwidth = {
        ['a']='ａ', ['b']='ｂ', ['c']='ｃ', ['d']='ｄ', ['e']='ｅ',
        ['f']='ｆ', ['g']='ｇ', ['h']='ｈ', ['i']='ｉ', ['j']='ｊ',
        ['k']='ｋ', ['l']='ｌ', ['m']='ｍ', ['n']='ｎ', ['o']='ｏ',
        ['p']='ｐ', ['q']='ｑ', ['r']='ｒ', ['s']='ｓ', ['t']='ｔ',
        ['u']='ｕ', ['v']='ｖ', ['w']='ｗ', ['x']='ｘ', ['y']='ｙ', ['z']='ｚ',
    }
    
    -- Randomly choose filter (50-50 chance)
    local useSmallCaps = math.random(1,2) == 1
    local selected = useSmallCaps and smallcaps or fullwidth
    
    local result = ""
    for i = 1, #text do
        local char = text:sub(i,i)
        local lowerChar = char:lower()
        if selected[lowerChar] then
            -- Check if original was uppercase
            if char == char:upper() and char:match("%a") then
                result = result .. selected[lowerChar]:upper()
            else
                result = result .. selected[lowerChar]
            end
        else
            result = result .. char
        end
    end
    return result
end

