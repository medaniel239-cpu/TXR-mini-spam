        local filtered = simpleBypass(text)
        channel:SendAsync(filtered)
        messageCount = messageCount + 1
        counterLabel.Text = "📨 " .. messageCount
    end
end

-- SPAM LOOP
task.spawn(function()
    while true do
        if spamming and input.Text ~= "" then
            local msg
            
            -- Send startup message first time only
            if not spamStarted then
                msg = "TXR_ASHU mini spam start"
                spamStarted = true
            else
                -- Normal message selection (prevents double spam)
                repeat
                    if randomMode then
                        msg = messages[math.random(1, #messages)]
                    else
                        msg = messages[msgIndex]
                        msgIndex = msgIndex + 1
                        if msgIndex > #messages then
                            msgIndex = 1
                        end
                    end
                until msg ~= lastMessage
                
                lastMessage = msg
            end
            
            local fullMessage = input.Text .. " " .. msg
            sendMessage(fullMessage)
            task.wait(spamSpeed)
        else
            task.wait(1)
        end
    end
end)

