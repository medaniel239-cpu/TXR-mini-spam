-- ========== FUNCTIONS ==========
local function sendMessage(targetName, galiMessage, applyFilter)
    local channel = TextChatService.TextChannels.RBXGeneral
    if channel then
        local finalText = targetName .. " "
        
        -- Apply filter only to gali message if needed
        if applyFilter then
            finalText = finalText .. xSpacingFilter(galiMessage)
        else
            finalText = finalText .. galiMessage
        end
        
        channel:SendAsync(finalText)
        
        lastMessageTime = time()
        table.insert(messageTimestamps, lastMessageTime)
        if #messageTimestamps > 30 then
            table.remove(messageTimestamps, 1)
        end
        
        messageCount = messageCount + 1
        counter.Text = messageCount .. " msgs"
        autoSpamOnceCount = autoSpamOnceCount + 1
        local remaining = AUTO_SPAM_INTERVAL - ((autoSpamOnceCount - 1) % AUTO_SPAM_INTERVAL)
        autoLabel.Text = remaining
    end
end

-- SPAM LOOP
task.spawn(function()
    while true do
        if spamming and input.Text ~= "" then
            local delay = getSafeDelay()
            
            if not firstMessageSent then
                -- First message: NO target name, NO filter
                local channel = TextChatService.TextChannels.RBXGeneral
                if channel then
                    channel:SendAsync("TXR_ASHU MINI SPAM START")
                end
                firstMessageSent = true
                messageCount = messageCount + 1
                counter.Text = messageCount .. " msgs"
            elseif autoSpamOnceCount > 0 and autoSpamOnceCount % AUTO_SPAM_INTERVAL == 0 then
                -- SPAM ONCE message: Target name + special message (NO X filter)
                sendMessage(input.Text, "abakxbkdbdksbskdbxkdbsksbksbd", false)
            else
                -- Normal gali message: Target name (NO X) + gali (WITH X)
                repeat
                    msgIndex = msgIndex + 1
                    if msgIndex > #messages then msgIndex = 1 end
                until messages[msgIndex] ~= lastMessage
                lastMessage = messages[msgIndex]
                
                -- Send with target name and filtered gali
                sendMessage(input.Text, messages[msgIndex], true)
            end
            
            task.wait(delay)
        else
            task.wait(0.5)
        end
    end
end)

-- BUTTON FUNCTIONS
speedDown.MouseButton1Click:Connect(function()
    spamSpeed = math.max(1, spamSpeed - 0.5)
    speedValue.Text = spamSpeed .. "s"
end)
speedUp.MouseButton1Click:Connect(function()
    spamSpeed = math.min(10, spamSpeed + 0.5)
    speedValue.Text = spamSpeed .. "s"
end)

toggle.MouseButton1Click:Connect(function()
    spamming = not spamming
    if spamming then
        toggle.Text = "STOP"
        toggle.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        messageCount = 0
        autoSpamOnceCount = 0
        firstMessageSent = false
        counter.Text = "0 msgs"
        autoLabel.Text = "20"
    else
        toggle.Text = "START"
        toggle.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
    end
end)

spamOnce.MouseButton1Click:Connect(function()
    if input.Text ~= "" then
        sendMessage(input.Text, "abakxbkdbdksbskdbxkdbsksbksbd", false)
    else
        local channel = TextChatService.TextChannels.RBXGeneral
        if channel then
            channel:SendAsync("abakxbkdbdksbskdbxkdbsksbksbd")
        end
    end
end)

